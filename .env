# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3002
API_URL=http://localhost:4000
PLATFORM_DOMAIN=nexos.app
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# ── Database ───────────────────────────────────────────────────────────────────
# Host port 5434 avoids colliding with a native PostgreSQL already on 5432.
POSTGRES_USER=nexos_user
POSTGRES_PASSWORD=nexos_pass
POSTGRES_DB=nexos_db
POSTGRES_PORT=5434
DATABASE_URL=postgresql://nexos_user:nexos_pass@localhost:5434/nexos_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ──────────────────────────────────────────────────────────────────────
# Host port 6380 avoids colliding with another Redis already on 6379.
REDIS_PASSWORD=nexos_redis_pass
REDIS_PORT=6380
REDIS_URL=redis://:nexos_redis_pass@localhost:6380
REDIS_PREFIX=nexos:
QUEUE_REDIS_URL=redis://:nexos_redis_pass@localhost:6380

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET=2f8a1c9d4e7b6a3f5c0d8e1b7f4a2c6d9e0b3a5f8c1d4e7b0a3f6c9d2e5b8a1f4
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=9c3e7a1b5d8f2a4c6e0b3d7f1a5c8e2b6d9f3a7c1e4b8d2f6a9c3e7b1d5f8a2c4

# ── OAuth ──────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Anthropic AI ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=4096

# ── Storage (S3 / MinIO) ───────────────────────────────────────────────────────
STORAGE_DRIVER=s3
S3_BUCKET=nexos-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=nexos_minio_user
S3_SECRET_KEY=nexos_minio_pass
S3_ENDPOINT=http://localhost:9000
CDN_URL=
MAX_FILE_SIZE_MB=100

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=
EMAIL_FROM=noreply@nexos.app
EMAIL_FROM_NAME=NexOS

# ── SMS / WhatsApp (Twilio) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ── Search ─────────────────────────────────────────────────────────────────────
MEILISEARCH_PORT=7700
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=nexos_meili_master_key

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
