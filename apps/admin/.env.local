# The URL of the *tenant-facing web app*. The admin console uses this when it
# opens a workspace (e.g. "Impersonate"), so it must point at the web app on
# :3002 — not at the admin console itself.
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000

# See apps/web/.env.local — silences the offline registry.npmjs.org check.
NEXT_TELEMETRY_DISABLED=1
