NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000

# Next.js phones home to registry.npmjs.org on boot to check for a newer
# release. On an offline machine that ends in
# "TypeError: fetch failed … ENOTFOUND registry.npmjs.org" on every start.
# Disabling telemetry skips that check as well.
NEXT_TELEMETRY_DISABLED=1
