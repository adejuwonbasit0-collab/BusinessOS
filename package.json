{
  "name": "nexos",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20.0.0", "pnpm": ">=9.0.0" },
  "packageManager": "pnpm@9.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @nexos/database db:migrate",
    "db:seed": "pnpm --filter @nexos/database db:seed",
    "db:reset": "pnpm --filter @nexos/database db:reset",
    "db:rollback": "pnpm --filter @nexos/database db:rollback"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.5"
  }
}
